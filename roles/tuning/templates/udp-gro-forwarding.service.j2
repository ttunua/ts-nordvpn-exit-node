[Unit]
Description=UDP GRO forwarding on {{ lan_iface }} (Tailscale exit-node throughput)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ethtool -K {{ lan_iface }} rx-udp-gro-forwarding on rx-gro-list off

[Install]
WantedBy=multi-user.target
